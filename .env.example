# Timezone (IANA name)
TZ=Asia/Tashkent

# Telegram bot token
BOT_TOKEN=

# Admin Telegram user ID (integer)
ADMIN_USER_ID=

# Gemini API key
GEMINI_API_KEY=

# The rest have defaults, uncomment to override.

# Telegram
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=

# Gemini model (gemini-2.5-pro, gemini-2.5-flash)
#GEMINI_MODEL=gemini-2.5-pro

# Max simultaneous jobs; the rest queue (integer)
#MAX_CONCURRENT=4
