# Telegram bot token
BOT_TOKEN=

# Admin Telegram user ID (integer)
ADMIN_USER_ID=

# Gemini API key
GEMINI_API_KEY=

# Timezone (IANA name)
TZ=Asia/Tashkent

# The rest have defaults, uncomment to override.

# Telegram
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=

# Gemini model (gemini-2.5-pro, gemini-2.5-flash)
#GEMINI_MODEL=gemini-2.5-pro

# Audio
# float, 1.0 = unchanged
#SPEEDUP_FACTOR=1.3

# Silence trimming (true or false)
#SILENCE_TRIM=true

# negative dB (negative integer)
#SILENCE_THRESHOLD_DB=-50

# seconds (integer or float)
#SILENCE_MIN_DURATION=0.5

# seconds (integer or float)
#SILENCE_PADDING_SEC=0.5
